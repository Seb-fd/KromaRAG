# ── KromaRAG .env.example ──
# Copy to .env (root) / apps/api/.env / apps/web/.env.local as needed.
# DB is fully generic: any Postgres+pgvector works (Neon, Supabase Postgres, Render, self-hosted).
# Use postgresql+asyncpg:// for FastAPI async, postgresql:// for psql/migrations.

# ── Environment (required) ──
# development = relaxed guards; production = fail-closed boot (specs/08 §6:
# https Clerk issuer, pooled Neon + sslmode, LLM keys, no chaos flags).
ENV=development

# ── Database (generic, required) ──
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/kromarag
# Optional direct SQLAlchemy sync URL for migrations/tools:
# DATABASE_URL_SYNC=postgresql://user:password@host:5432/kromarag
PGVECTOR_DIM=768

# ── LLM Providers ──
# Google AI Studio (Gemini — primary)
GOOGLE_API_KEY=
GEMINI_API_KEY=${GOOGLE_API_KEY}
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
# Groq (fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PRIMARY=gemini
LLM_FALLBACK=groq

# ── Observability (LangSmith) ──
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=KromaRAG
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Telemetry & Operations (specs/09) ──
OTEL_ENABLED=true
OTEL_SAMPLING_OK=0.1
OTEL_SAMPLING_ERROR=1.0
METRICS_ENABLED=true
# Comma-separated IP/CIDR allowlist for GET /metrics (dual-gated with admin JWT).
# Empty = allow all in non-prod, deny all in prod (fail-closed).
METRICS_SCRAPE_ALLOWLIST=
# Chaos flags: staging-only, forced off in production (boot RuntimeError otherwise).
CHAOS_SQL_DELAY_MS=0
CHAOS_GEMINI_DOWN=false
CHAOS_POOL_MAX=0
K6_QUERY_VUS=20
K6_UPLOAD_VUS=5

# ── Clerk (frontend) + FastAPI JWT validation ──
# Clerk apps: kromarag-dev (local/staging) + kromarag-prod (prod); never share keys.
# Dashboard → API Keys: publishable key is public (NEXT_PUBLIC_*), secret stays server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE-ME
CLERK_SECRET_KEY=sk_test_REPLACE-ME
# Clerk routing: keep auth local (never fall back to accounts.dev hosted pages).
# Unified custom flow: sign-in + sign-up both live at /login.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
# Dev-only Credentials bypass (strictly non-prod; must match in apps/web/.env.local + apps/api/.env):
# AUTH_SECRET=change-me-32-chars-min
# JWKS / issuer used by apps/api/core/security.py:
# Clerk issuer (https://<app>.clerk.accounts.dev); JWKS at {issuer}/.well-known/jwks.json.
# Dev keeps the loopback issuer for the HS256 bypass (jwt_jwks_enabled=false locally).
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=kromarag-web
# Optional explicit JWKS pin (default derives {JWT_ISSUER}/.well-known/jwks.json):
# CLERK_JWKS_URL=
# JWT_JWKS_URL=
# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Frontend public
NEXT_PUBLIC_API_URL=http://localhost:8000

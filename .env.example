# ── KromaRAG .env.example ──
# Copy to .env (root) / apps/api/.env / apps/web/.env.local as needed.
# DB is fully generic: any Postgres+pgvector works (Neon, Supabase Postgres, Render, self-hosted).
# Use postgresql+asyncpg:// for FastAPI async, postgresql:// for psql/migrations.

# ── Database (generic, required) ──
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/kromarag
# Optional direct SQLAlchemy sync URL for migrations/tools:
# DATABASE_URL_SYNC=postgresql://user:password@host:5432/kromarag
PGVECTOR_DIM=768

# ── LLM Providers ──
# Google AI Studio (Gemini — primary)
GOOGLE_API_KEY=
GEMINI_API_KEY=${GOOGLE_API_KEY}
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
# Groq (fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PRIMARY=gemini
LLM_FALLBACK=groq

# ── Observability (LangSmith) ──
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=KromaRAG
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Telemetry & Operations (specs/09) ──
OTEL_ENABLED=true
OTEL_SAMPLING_OK=0.1
OTEL_SAMPLING_ERROR=1.0
METRICS_ENABLED=true
# Comma-separated IP/CIDR allowlist for GET /metrics (dual-gated with admin JWT).
# Empty = allow all in non-prod, deny all in prod (fail-closed).
METRICS_SCRAPE_ALLOWLIST=
# Chaos flags: staging-only, forced off in production (boot RuntimeError otherwise).
CHAOS_SQL_DELAY_MS=0
CHAOS_GEMINI_DOWN=false
CHAOS_POOL_MAX=0
K6_QUERY_VUS=20
K6_UPLOAD_VUS=5

# ── Auth.js (frontend) + FastAPI JWT validation ──
AUTH_SECRET=change-me-32-chars-min
NEXTAUTH_URL=http://localhost:3000
# JWKS / issuer used by apps/api/core/security.py:
# For Auth.js v5 (Auth.js): issuer is NEXTAUTH_URL, JWKS at {issuer}/.well-known/jwks.json
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=kromarag-web
# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Frontend public
NEXT_PUBLIC_API_URL=http://localhost:8000

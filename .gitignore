# ── KromaRAG .gitignore ──
# Node / Next.js / Vercel
node_modules/
.next/
out/
dist/
build/
*.log
.vercel
# npm / yarn / pnpm
yarn-error.log
.pnpm-store/

# Python / FastAPI / uv
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
# uv.lock is COMMITTED for reproducible prod builds (specs/08). Do not ignore.
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
.env.staging
.env.local
.env.production
.env.*.local
# Debug credentials (never commit)
debug-credentials.local.md
*.local.md
apps/web/.env.local
apps/api/.env

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Agent skills (generated, do not commit)
.cursor/skills/
.codex/skills/
.opencode/skill/
.agents/skills/
skills/npm-*
CLAUDE.md

# Misc
coverage/
.coverage
coverage.xml
htmlcov/
*.sqlite
*.db
*.tsbuildinfo
temp/

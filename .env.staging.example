# ── KromaRAG .env.staging.example ──
# STAGING env matrix (specs/08 §6). Copy to `.env.staging` for local
# staging-parity runs — NEVER commit `.env.staging` (gitignored, real secrets).
# Staging runs the SAME fail-closed guards as prod (scripts set ENV=production)
# but against staging backends: Neon staging branch, Clerk DEV app, -staging hosts.
# Real secrets live in Secret Manager (see scripts/deploy/00-secrets.*);
# only non-secret knobs are set here.

# ── Environment (staging runs prod guards) ──
ENV=production

# ── Database: Neon STAGING branch (generic form) ──
DATABASE_URL=postgresql+asyncpg://user:password@xxx-pooler.eu-west-1.neon.tech:5432/kromarag_staging?sslmode=require
DATABASE_URL_SYNC=postgresql://user:password@xxx.eu-west-1.neon.tech:5432/kromarag_staging?sslmode=require
PGVECTOR_DIM=768

# ── LLM Providers (keys via Secret Manager, empty here) ──
GOOGLE_API_KEY=
GEMINI_API_KEY=${GOOGLE_API_KEY}
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PRIMARY=gemini
LLM_FALLBACK=groq

# ── LangSmith (staging project isolates prod traces) ──
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=KromaRAG-staging
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Auth: Clerk DEV app issuer + staging web origin ──
# JWT_ISSUER is the Clerk issuer, NOT the web URL (specs/08 §3.3).
JWT_ISSUER=https://kromarag-dev.clerk.accounts.dev
JWT_AUDIENCE=kromarag-web
CORS_ORIGINS=https://kroma-rag.vercel.app
#METRICS_SCRAPE_ALLOWLIST=  # empty = deny-all on /metrics (fail-closed healthy)

# ── Web (Vercel Preview) ──
NEXT_PUBLIC_API_URL=https://kromarag-api-staging-xxx.a.run.app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE-ME
CLERK_SECRET_KEY=sk_test_REPLACE-ME

# ── Perf knobs (specs/08 §6 defaults; same as prod) ──
POOL_MIN_SIZE=2
POOL_MAX_SIZE=20
POOL_COMMAND_TIMEOUT=10
RATE_LIMIT_QUERY_PER_MIN=100
RATE_LIMIT_INGEST_PER_MIN=20
RATE_LIMIT_UNAUTH_PER_MIN=10
RATE_LIMIT_ADMIN_PER_MIN=300
RATE_LIMIT_READ_PER_MIN=300
LLM_TIMEOUT_S=25
LLM_FALLBACK_TIMEOUT_S=12
EMBED_TIMEOUT_S=8
RETRIEVER_TIMEOUT_MS=3000

# ── Telemetry ──
OTEL_ENABLED=true
OTEL_SAMPLING_OK=0.1
OTEL_SAMPLING_ERROR=1.0
METRICS_ENABLED=true

# ── Chaos (staging-only; prod boot fails if non-zero — specs/08 §6) ──
CHAOS_SQL_DELAY_MS=0
CHAOS_GEMINI_DOWN=false
CHAOS_POOL_MAX=0

# ── Cloud Run (see scripts/deploy/11-cloudrun-staging.*) ──
# In-memory limiter math: effective limit = per-instance x instances.
# MAX_INSTANCES=3 until the Redis swap (specs/08 §3.2, rate_limit.py).
REGION=europe-west1
SERVICE=kromarag-api-staging
MAX_INSTANCES=3

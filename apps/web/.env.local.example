NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Server-only rewrite target (used by next.config.js rewrites(); never NEXT_PUBLIC_).
API_URL=http://127.0.0.1:8000
# When "1", lib/api-client.ts + lib/store.tsx use relative URLs (same-origin
# Next.js rewrite proxy) instead of direct cross-origin fetch. Dev=1, Vercel prod=0/unset.
NEXT_PUBLIC_USE_PROXY=1
# ── Clerk (kromarag-dev app for local/staging, kromarag-prod for prod; never share) ──
# Dashboard → API Keys: publishable key is public (NEXT_PUBLIC_*), secret stays server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE-ME
CLERK_SECRET_KEY=sk_test_REPLACE-ME
# ── Clerk routing: keep auth local (never fall back to accounts.dev hosted pages) ──
# Unified custom flow: sign-in + sign-up both live at /login.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
# ── Dev-only Credentials bypass (strictly NODE_ENV !== "production") ──
# The /api/dev-token route mints local HS256 with this secret; it must match
# apps/api/.env AUTH_SECRET. Never set in Vercel (prod route 404s; backend
# rejects kid-less HS256 when ENV=production).
AUTH_SECRET=change-me-32-chars-min-replace-in-prod

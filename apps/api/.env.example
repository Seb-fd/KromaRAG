# KromaRAG API — copy to .env and fill DATABASE_URL (generic Neon/Postgres).
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/kromarag
PGVECTOR_DIM=768

# ── LLM Providers ──
# Google AI Studio (Gemini — primary)
GOOGLE_API_KEY=
GEMINI_API_KEY=${GOOGLE_API_KEY}
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
# Groq (fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PRIMARY=gemini
LLM_FALLBACK=groq

# ── Dev-only HS256 bypass (strictly non-prod; must match apps/web/.env.local) ──
# Prod rejects kid-less HS256 outright (Clerk RS256 required).
AUTH_SECRET=change-me-32-chars-min
# AUTH_SECRET_CURRENT=
# AUTH_SECRET_PREVIOUS=
# ── Clerk (kromarag-dev locally, kromarag-prod in prod) ──
# Prod: JWT_ISSUER=https://<app>.clerk.accounts.dev (https + non-localhost, fail-closed).
#
# Local JWT_ISSUER toggle (pick ONE, restart the backend after changing):
# - Clerk issuer (https://<app>.clerk.accounts.dev): real Clerk sessions verify.
#   Use this for real-auth end-to-end testing. Dev-bypass HS256 tokens 401 here
#   (they mint with iss=http://localhost:3000), which is expected.
# - http://localhost:3000: dev-bypass HS256 tokens verify (pure local loop, no
#   Clerk session needed). Real Clerk RS256 tokens will NOT verify here.
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=kromarag-web
# Optional explicit JWKS pin (default derives {JWT_ISSUER}/.well-known/jwks.json):
# CLERK_JWKS_URL=
# JWT_JWKS_URL=
# JWT_JWKS_ENABLED=true (false = pure HS256 dev, never in prod)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Spec 08: prod posture (Cloud Run + Neon pooled) ──
# ENV=development
# DATABASE_URL_SYNC=postgresql://user:password@host:5432/kromarag
# POOL_MIN_SIZE=2
# POOL_MAX_SIZE=20
# POOL_COMMAND_TIMEOUT=10
# RATE_LIMIT_QUERY_PER_MIN=100
# RATE_LIMIT_INGEST_PER_MIN=20
# RATE_LIMIT_UNAUTH_PER_MIN=10
# RATE_LIMIT_ADMIN_PER_MIN=300
# LLM_FALLBACK_TIMEOUT_S=12
# EMBED_TIMEOUT_S=8
# RETRIEVER_TIMEOUT_MS=3000

# ── Spec 09: telemetry & ops (mirrors root .env.example; see specs/09 §2.5) ──
# OTEL_ENABLED=true
# OTEL_SAMPLING_OK=0.1
# OTEL_SAMPLING_ERROR=1.0
# METRICS_ENABLED=true
# METRICS_SCRAPE_ALLOWLIST=
# CHAOS_SQL_DELAY_MS=0
# CHAOS_GEMINI_DOWN=false
# CHAOS_POOL_MAX=0
# K6_QUERY_VUS=20
# K6_UPLOAD_VUS=5
